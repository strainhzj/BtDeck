[Unit]
Description=BtDeck - BitTorrent Management Platform
After=network.target

[Service]
Type=simple
User=btdeck
Group=btdeck
WorkingDirectory=/opt/btdeck
ExecStart=/opt/btdeck/btdeck
Restart=on-failure
RestartSec=5

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/btdeck/config /opt/btdeck/data /opt/btdeck/logs /opt/btdeck/backup /opt/btdeck/torrents

# 环境变量
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
Environment=DEV=false
Environment=HOST=0.0.0.0
Environment=PORT=5001
Environment=ALLOWED_HOSTS=http://127.0.0.1:5001,http://localhost:5001
EnvironmentFile=-/opt/btdeck/config/btdeck.env

[Install]
WantedBy=multi-user.target
