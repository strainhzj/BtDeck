[Unit]
Description=BtDeck - BitTorrent Management Platform
After=network.target

[Service]
Type=simple
User=btdeck
Group=btdeck
WorkingDirectory=/opt/btdeck
ExecStart=/opt/btdeck/btdeck
Restart=on-failure
RestartSec=5

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# PyInstaller onefile 需要可写解压目录；ProtectSystem=strict 下 /tmp 只读，
# 必须提供私有可写 tmp（W3 生命周期实测拦截：否则 bootloader 报
# "Could not create temporary directory!" 并进入 restart 循环）
PrivateTmp=true
ReadWritePaths=/opt/btdeck/config /opt/btdeck/data /opt/btdeck/logs /opt/btdeck/backup /opt/btdeck/torrents

# 环境变量
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
Environment=DEV=false
Environment=HOST=0.0.0.0
Environment=PORT=5001
# pydantic-settings 对 List[str] 强制 JSON 解析，须用 JSON 数组格式
Environment=ALLOWED_HOSTS=["http://127.0.0.1:5001","http://localhost:5001"]
EnvironmentFile=-/opt/btdeck/config/btdeck.env

[Install]
WantedBy=multi-user.target
