# BtDeck Nginx TLS 反向代理参考配置（安全修复 W14）
#
# 默认部署为纯 HTTP（frontend 容器 8080:80，token/密码明文传输可被嗅探）。
# 公网/跨网络部署必须启用 TLS。本文件是 frontend/nginx.conf 的 HTTPS 变体，
# 替换证书路径后使用。核心要点：
#   - HTTP 全部 301 到 HTTPS
#   - HSTS（Strict-Transport-Security）
#   - 保留 /api/ 与 /ws/ 代理（后端容器内网可达，无需对外暴露 5001）
#
# 使用：将本 server 块替换 frontend/nginx.conf 的 listen 80 server 块，
# 证书挂载进 frontend 容器（如 ./data/certs:/etc/nginx/certs:ro），
# 并同步修改 .env 的 ALLOWED_HOSTS=https://your-domain。

server {
    listen 80;
    server_name _;
    # 强制 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # HSTS：浏览器强制 HTTPS（一年；preload 需先登记）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # 其余安全头同 frontend/nginx.conf
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    root /usr/share/nginx/html;
    index index.html;

    location = /service-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        access_log off;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location = /api/v1/auth/login {
        client_max_body_size 1M;
        proxy_pass http://btdeck-backend:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /api/ {
        client_max_body_size 100M;
        proxy_pass http://btdeck-backend:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /ws/ {
        proxy_pass http://btdeck-backend:5002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
        # 隐藏文件
        location ~ /\. {
            deny all;
        }
    }
}
