{
  "version": 2,
  "maxRegexConditions": 3,
  "maxRegexPatternLength": 256,
  "nullOperators": ["is_null", "is_not_null"],
  "negatedOperators": {
    "eq": "ne",
    "ne": "eq",
    "contains": "not_contains",
    "not_contains": "contains",
    "starts_with": "not_starts_with",
    "not_starts_with": "starts_with",
    "ends_with": "not_ends_with",
    "not_ends_with": "ends_with",
    "in": "not_in",
    "not_in": "in",
    "contains_any": "not_contains_any",
    "not_contains_any": "contains_any",
    "contains_all": "not_contains_all",
    "not_contains_all": "contains_all",
    "gt": "lte",
    "gte": "lt",
    "lt": "gte",
    "lte": "gt"
  },
  "fields": {
    "info_id": {"kind": "text", "operators": ["eq", "ne", "contains", "not_contains", "starts_with", "ends_with", "not_starts_with", "not_ends_with", "in", "not_in", "regex"]},
    "downloader_id": {"kind": "text", "operators": ["eq", "ne", "in", "not_in"]},
    "downloader_name": {"kind": "multiSelect", "operators": ["eq", "ne", "in", "not_in"]},
    "torrent_id": {"kind": "text", "operators": ["eq", "ne", "contains", "not_contains", "starts_with", "ends_with", "not_starts_with", "not_ends_with", "in", "not_in", "regex"]},
    "hash": {"kind": "text", "operators": ["eq", "ne", "contains", "not_contains", "starts_with", "ends_with", "not_starts_with", "not_ends_with", "in", "not_in", "regex"]},
    "name": {"kind": "text", "operators": ["eq", "ne", "contains", "not_contains", "starts_with", "ends_with", "not_starts_with", "not_ends_with", "in", "not_in", "regex"]},
    "save_path": {"kind": "text", "operators": ["eq", "ne", "contains", "not_contains", "starts_with", "ends_with", "not_starts_with", "not_ends_with", "in", "not_in", "regex"]},
    "size": {"kind": "number", "operators": ["eq", "ne", "gt", "gte", "lt", "lte", "between"]},
    "status": {"kind": "multiSelect", "operators": ["eq", "ne", "in", "not_in"]},
    "added_date": {"kind": "date", "operators": ["eq", "ne", "gt", "gte", "lt", "lte", "between", "last_days", "date_range"]},
    "added_time": {"kind": "date", "operators": ["eq", "ne", "gt", "gte", "lt", "lte", "between", "last_days", "date_range"]},
    "completed_date": {"kind": "date", "operators": ["eq", "ne", "gt", "gte", "lt", "lte", "between", "last_days", "date_range"]},
    "ratio": {"kind": "number", "operators": ["eq", "ne", "gt", "gte", "lt", "lte", "between"]},
    "ratio_limit": {"kind": "number", "operators": ["eq", "ne", "gt", "gte", "lt", "lte", "between"]},
    "tags": {"kind": "multiSelect", "operators": ["eq", "ne", "contains", "not_contains", "contains_any", "contains_all", "not_contains_any", "not_contains_all"]},
    "category": {"kind": "multiSelect", "operators": ["eq", "ne", "in", "not_in"]},
    "super_seeding": {"kind": "boolean", "operators": ["eq", "ne"]},
    "enabled": {"kind": "boolean", "operators": ["eq", "ne"]},
    "tracker_url": {"kind": "text", "operators": ["eq", "ne", "contains", "not_contains", "starts_with", "ends_with", "not_starts_with", "not_ends_with", "in", "not_in", "regex"]},
    "tracker_msg": {"kind": "text", "operators": ["eq", "ne", "contains", "not_contains", "starts_with", "ends_with", "not_starts_with", "not_ends_with", "in", "not_in", "regex"]}
  },
  "operatorGroups": {
    "text": [
      {"value": "contains", "label": "包含", "backendValue": "contains"},
      {"value": "not_contains", "label": "不包含", "backendValue": "not_contains"},
      {"value": "equals", "label": "等于", "backendValue": "eq"},
      {"value": "not_equals", "label": "不等于", "backendValue": "ne"},
      {"value": "starts_with", "label": "开头是", "backendValue": "starts_with"},
      {"value": "ends_with", "label": "结尾是", "backendValue": "ends_with"},
      {"value": "regex", "label": "正则匹配", "backendValue": "regex"}
    ],
    "number": [
      {"value": "equals", "label": "等于", "backendValue": "eq"},
      {"value": "not_equals", "label": "不等于", "backendValue": "ne"},
      {"value": "greater_than", "label": "大于", "backendValue": "gt"},
      {"value": "less_than", "label": "小于", "backendValue": "lt"},
      {"value": "greater_equal", "label": "大于等于", "backendValue": "gte"},
      {"value": "less_equal", "label": "小于等于", "backendValue": "lte"},
      {"value": "between", "label": "介于", "backendValue": "between"}
    ],
    "date": [
      {"value": "equals", "label": "等于", "backendValue": "eq"},
      {"value": "not_equals", "label": "不等于", "backendValue": "ne"},
      {"value": "greater_than", "label": "晚于", "backendValue": "gt"},
      {"value": "less_than", "label": "早于", "backendValue": "lt"},
      {"value": "greater_equal", "label": "不早于", "backendValue": "gte"},
      {"value": "less_equal", "label": "不晚于", "backendValue": "lte"},
      {"value": "last_days", "label": "最近N天", "backendValue": "last_days"},
      {"value": "date_range", "label": "日期范围", "backendValue": "date_range"}
    ],
    "select": [
      {"value": "equals", "label": "等于", "backendValue": "eq"},
      {"value": "not_equals", "label": "不等于", "backendValue": "ne"},
      {"value": "in", "label": "在列表中", "backendValue": "in"},
      {"value": "not_in", "label": "不在列表中", "backendValue": "not_in"}
    ],
    "multiSelect": [
      {"value": "in", "label": "包含任意", "backendValue": "in"},
      {"value": "not_in", "label": "不包含任意", "backendValue": "not_in"},
      {"value": "contains_any", "label": "包含任意", "backendValue": "contains_any"},
      {"value": "not_contains_any", "label": "不包含任意", "backendValue": "not_contains_any"}
    ],
    "boolean": [
      {"value": "equals", "label": "等于", "backendValue": "eq"},
      {"value": "not_equals", "label": "不等于", "backendValue": "ne"}
    ]
  }
}
