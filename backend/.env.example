# BTDeck 后端环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ================================
# 应用基础配置
# ================================
PROJECT_NAME=btdeck

# ================================
# 数据库配置
# ================================
# SQLite 数据库文件名（相对于 config/ 目录）
DATABASE_NAME=app.db

# ================================
# 安全配置
# ================================
# JWT 密钥（生产环境务必修改为随机字符串）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=YM4nwx3QBbZ227i5itqf

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=600

# JWT 算法（默认 HS256，不建议修改）
ALGORITHM=HS256

# Tracker-only 同步分批提交粒度（每处理多少个种子提交一次事务，默认 1000）
# TRACKER_ONLY_COMMIT_BATCH=1000

# ================================
# 同步任务数据库写入治理配置（W1-1 真分批提交）
# ================================
# 真分批提交开关：True 时通用批量写入按批次真实 commit（每批独立事务），
# False 时回退为单事务一次提交（快速回滚，最多保留两个稳定版本）
# SYNC_CHUNKED_COMMIT_ENABLED=true
# 单批最大尝试次数（含首次；锁冲突只重试当前失败批，默认 3）
# SYNC_DB_LOCK_RETRY_COUNT=3
# 单批重试总退避上限（秒）：任何一批的重试总睡眠不超过该值，防止排队雪崩
# SYNC_DB_RETRY_MAX_BACKOFF_SECONDS=2.0
# DB 批量提交大小（每批独立 commit 的行数上限，默认 200）
# SYNC_DB_COMMIT_BATCH_SIZE=200
# Tracker 关键词状态增量写回开关（W1-2）：True 只写变化行（零变化零 DML），
# False 回退旧逻辑（全部写回）。判定规则不受影响。
# SYNC_TRACKER_STATUS_INCREMENTAL_ENABLED=true
# 统一 SyncCoordinator 开关（W2-1）：True 时手动同步（sync-single）与定时任务
# （info/tracker）统一经 SyncCoordinator 执行（统一资源准入/写治理/观测）。
# False 时手动入口回退旧直接调用 torrent_sync_db_async 全量同步的路径（应急回滚）。
# ⚠️ legacy 只能作为应急回退，禁止与新路径同时执行；两个稳定版本后删除。
# SYNC_CANONICAL_COORDINATOR_ENABLED=true

# ================================
# 下载器 API 调用容量配置（W2-2 交互容量保留）
# ================================
# 每下载器总并发（跨 lane 共享硬上限，默认 2）。
# 注意 requests.Session 非线程安全，提并发可能偶发连接错误。
# DOWNLOADER_IO_CONCURRENCY=2
# 每下载器后台容量：background 调用（TRACKER/SYNC lane）最多占用该数量的并发槽，
# 其余槽始终保留给交互请求（INTERACTIVE lane）。默认 1：后台最多占 1 槽，交互保留 1 槽。
# 不得大于等于总容量（如总容量=1 时配置为 1 会占满全部槽破坏交互保留槽），
# 该矛盾组合会在运行时自动降级为 0 并记录警告。
# DOWNLOADER_BACKGROUND_CAPACITY=1

# ================================
# 服务器配置
# ================================
# API 服务端口（默认 5001）
# API_PORT=5001

# WebSocket 服务端口（默认 5002）
# WS_PORT=5002

# ================================
# 日志配置
# ================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# ================================
# 开发模式配置
# ================================
# 开发环境: true
# 生产环境: false
# DEBUG=false
