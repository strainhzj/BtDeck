# BtDeck flake8 配置
# 策略：渐进式收紧。当前历史代码有问题，先放过风格类，聚焦真实错误（F/E9）。
# 历史技术债记录在 docs/tech-debt-lint-baseline.md，逐步清理。

[flake8]
max-line-length = 120
extend-exclude =
    .venv,
    __pycache__,
    build,
    dist,
    app/migrations,
    app/api/_legacy_router_unused.py

# 选择性忽略（历史代码清理后逐步移除）
# E203: 冒号前空格（与 black 冲突，必须忽略——black 官方推荐）
# E402: 模块级 import 不在顶部（历史代码有条件 import，逐步清）
# E501: 行太长（历史长 SQL/URL 字符串，black 无法拆，逐步清）
# E711/E712: 与 None/False 比较（历史代码风格，低风险）
# E722: 裸 except（历史代码，逐步改）
# E741: 模糊变量名 l（历史代码）
# F401: 未使用 import（历史代码大量存在，用 autoflake 批量清）
# F541: f-string 无占位符（低风险，逐步清）
# F811: 重定义（多为条件 import）
# F841: 局部变量赋值未用（历史代码，逐步清）
# W503/W504: 二元运算符换行（与 black 冲突，必须忽略）
# W605: 无效转义序列（历史正则，逐步改 raw string）
extend-ignore =
    E203,
    E402,
    E501,
    E711,
    E712,
    E722,
    E741,
    F401,
    F541,
    F811,
    F841,
    W503,
    W504,
    W605

# per-file-ignore：对技术债密集的历史文件额外豁免
per-file-ignores =
    # 历史文件：真实 bug（F821 undefined name）记录为技术债，单独清理
    app/utils/audit_logger.py: F821,F841
    app/api/endpoints/torrent_crud.py: F821
    app/api/endpoints/torrent_deletion.py: F821
    app/services/tag_service.py: F821
    app/downloader/initialization.py: F821,F824
    app/core/security.py: F824
    # 诊断/脚本：允许较宽松
    scripts/*: F841,E501
