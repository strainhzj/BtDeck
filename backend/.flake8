# BtDeck flake8 配置
# 策略：渐进式收紧。当前历史代码有问题，先放过风格类，聚焦真实错误（F/E9）。
# 历史技术债记录在 docs/tech-debt-lint-baseline.md，逐步清理。

[flake8]
max-line-length = 120
extend-exclude =
    .venv,
    __pycache__,
    build,
    dist,
    app/migrations

# 选择性忽略（历史代码清理后逐步移除）
# E203: 冒号前空格（与 black 冲突，必须忽略——black 官方推荐）
# E402: 模块级 import 不在顶部（历史代码有条件 import，逐步清）
# E501: 行太长（历史长 SQL/URL 字符串，black 无法拆，逐步清）
# E711/E712: 与 None/False 比较（历史代码风格，低风险）
# E722/E741 已于 2026-06-26 全量清理（4→0），从 extend-ignore 移除进入门禁
# F541 已于 2026-06-26 全量清理（74→0），从 extend-ignore 移除进入门禁
# F811 已于 2026-06-27 全量清理（15→0，cuser 改名 + torrents_async 删过期副本），从 extend-ignore 移除进入门禁
# F841 已于 2026-06-26 全量清理（23→0），从 extend-ignore 移除进入门禁
# W503/W504: 二元运算符换行（与 black 冲突，必须忽略）
# W605: 无效转义序列（历史正则，逐步改 raw string）
# F401 已于 2026-06-25 全量清理（321→9），从 extend-ignore 移除，
# 新增代码未用 import 现已进入门禁。database.py 的 9 个残留是
# 有意保留的 ORM 模型注册 import，见 per-file-ignores。
extend-ignore =
    E203,
    E402,
    E501,
    E711,
    E712,
    W503,
    W504,
    W605

# per-file-ignore：对技术债密集的历史文件额外豁免
per-file-ignores =
    # database.py: init_db 内 9 个 ORM 模型 import 是防御性注册
    # （确保模型注册到 Base.metadata），不是未用 import，故豁免 F401
    app/database.py: F401
    # 诊断/脚本：允许较宽松
    scripts/*: F841,E501
# 注：原 F821/F824 真实 bug（audit_logger/torrent_crud/torrent_deletion/
# tag_service/initialization/security）已于 2026-06-26 全部修复并清零，
# 对应 per-file-ignores 已移除，F821/F824 现进入全仓门禁。
