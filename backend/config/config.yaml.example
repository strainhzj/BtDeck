# BTDeck 配置文件模板
# 复制为 config.yaml 并填入实际值，切勿将 config.yaml 提交到版本控制
# 密钥生成: python -c "import secrets; print(secrets.token_hex(16))"

app:
  name: BtDeck
  version: 1.0.4
  debug: false
  log_level: INFO
database:
  host: localhost
  port: 3306
  username: user
  password: password
  database: mydb
  charset: utf8mb4
  pool_size: 5
server:
  host: 0.0.0.0
  port: 8000
  workers: 4
  timeout: 60
security:
  # 必须替换为随机值（安全修复 W7）：此文件曾被 git 跟踪且含真实密钥，
  # 任何使用模板默认值/历史值的部署共享同一加密主密钥（用户密码 AES-ECB
  # 与下载器密码 SM4 均依赖它）。生成: python -c "import secrets; print(secrets.token_hex(16))"
  # 注意：首次启动 init_config_file 只会补缺失字段，不会覆盖已有密钥——
  # 升级部署务必手动更新本文件后再启动。
  secret_key: your-secret-key-here
  token_expire_minutes: 60
  algorithm: HS256
  login_status_secret: your-login-secret-here
  # JWT 签名密钥（SECRET_KEY 环境变量缺省时的回退源）：刻意保持注释缺席——
  # 首次启动 init_config_file 会自动生成随机值并补入。切勿填写任何示例值：
  # "缺失才补"语义下，照抄的公开已知密钥会被永久沿用为签名密钥。
  # jwt_secret_key: <留空自动生成，或 python -c "import secrets; print(secrets.token_hex(32))">
cors:
  allowed_origins:
  - '*'
  allowed_methods:
  - '*'
  allowed_headers:
  - '*'
logging:
  file: app.log
  max_size_mb: 10
  backup_count: 5
