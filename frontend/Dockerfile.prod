# BTDeck 前端 Dockerfile（生产环境）
# 多阶段构建：Node.js 构建 → Nginx 服务

# ====================================
# 阶段1: 构建阶段
# ====================================
# Node 22 线（W0 探针实测 22.23.2 全量矩阵通过），digest 固定（W1/G2）：
# node:22-bookworm-slim @ sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS builder

LABEL maintainer="BTDeck Team"
LABEL description="BTDeck 前端构建阶段"

# 镜像源参数化（默认空串 = 走官方源，与改造前行为一致）
# 由 build-and-export-images.bat 通过 --build-arg 注入，构建失败可切换备用源重试
ARG APT_MIRROR=
ARG NPM_REGISTRY=
# 通过 ENV 让本阶段所有 npm 命令自动读取 registry（空串时走官方 npmjs.org）
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}

# 设置工作目录
WORKDIR /app

# 安装构建依赖
# 同时替换 deb.debian.org 和 security.debian.org（Bookworm deb822 格式）；APT_MIRROR 为空则跳过
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|security.debian.org/debian-security|${APT_MIRROR}/debian-security|g; s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 设置 node-gyp 使用 Python3
ENV PYTHON=/usr/bin/python3

# 复制 package 文件
COPY package*.json ./

# 安装依赖（使用 --legacy-peer-deps 解决依赖冲突）
# npm registry 由上面的 ENV 自动生效（NPM_REGISTRY 为空时走官方 npmjs.org）
RUN npm ci --legacy-peer-deps && npm cache clean --force

# 复制项目文件
COPY . .

# 复制生产环境配置（如果存在）
COPY .env.production ./

# 构建项目
RUN npm run build

# ====================================
# 阶段2: 生产运行阶段
# ====================================
# digest 固定（W1/G2）：nginx:1.25-alpine @ sha256:516475cc129da42866742567714ddc681e5eed7b9ee0b9e9c015e464b4221a00
FROM nginx:1.25-alpine@sha256:516475cc129da42866742567714ddc681e5eed7b9ee0b9e9c015e464b4221a00

LABEL maintainer="BTDeck Team"
LABEL description="BTDeck 前端生产环境 - Nginx 静态文件服务"

# OCI 身份标签（G1/G10）：正式构建注入 --build-arg；W2 严格模式校验非空
ARG OCI_VERSION=""
ARG OCI_REVISION=""
ARG OCI_CREATED=""
ARG OCI_SOURCE="https://github.com/strainhzj/BtDeck"
LABEL org.opencontainers.image.title="BtDeck frontend" \
      org.opencontainers.image.description="BTDeck 前端生产环境 - Nginx 静态文件服务" \
      org.opencontainers.image.version="${OCI_VERSION}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.source="${OCI_SOURCE}"

# 安装时区数据和 wget（用于健康检查）
RUN apk add --no-cache tzdata wget && \
    # 设置时区
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    # 删除默认配置和网站
    rm -rf /etc/nginx/conf.d/default.conf && \
    rm -rf /usr/share/nginx/html/*

# 从构建阶段复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 Nginx 配置
COPY nginx.conf /etc/nginx/nginx.conf

# 创建非特权用户
RUN addgroup -g 1001 -S nginx-group && \
    adduser -S -D -H -u 1001 -h /usr/share/nginx/html -s /sbin/nologin -G nginx-group nginx-user && \
    chown -R nginx-user:nginx-group /usr/share/nginx/html && \
    chown -R nginx-user:nginx-group /var/cache/nginx && \
    chown -R nginx-user:nginx-group /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx-user:nginx-group /var/run/nginx.pid

# 切换到非特权用户
USER nginx-user

# 暴露端口
EXPOSE 80

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1

# 启动 Nginx（前台模式）
CMD ["nginx", "-g", "daemon off;"]
