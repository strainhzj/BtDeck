# BtDeck 环境变量配置
# 复制此文件为 .env 并根据需要修改

# 服务端口
BTDECK_PORT=8080

# 时区（2026-09-07 时间戳单基准治理）：保持 UTC——naive datetime.now() 写库 +
# serialize_utc_datetime "naive=UTC" 标 Z 契约要求容器本地时间为 UTC；
# cron 触发时刻硬编码 Asia/Shanghai 不受影响。仅本地调试需要墙钟对齐时才改。
TZ=UTC

# 数据库路径（可选，默认 <CONFIG_DIR>/app.db）
# DATABASE_PATH 指定后，应用与 alembic 迁移都操作此库（治理后双源一致）
# DATABASE_PATH=/data/app.db

# ========== PostgreSQL 可选数据源（v1.0.8 双数据库，契约 backend/docs/postgresql-contract.md §2）==========
# 默认 sqlite（上方 DATABASE_PATH）。切换 PG：设 DB_TYPE=postgresql 并配置下方连接；
# PG 模式下 DATABASE_PATH 不被消费。非法 DB_TYPE 取值启动即报错（fail-fast，防静默回落）。
# 注意：PG 模式要求 WORKERS=1（单实例单 worker 交付边界，契约 §1）。
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=btdeck
# DB_PASSWORD=
# DB_NAME=btdeck
# 连接池（sync QueuePool / async AsyncAdaptedQueuePool；SQLite 不消费）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# TLS：disable/prefer/require/verify-ca/verify-full（默认 prefer；契约 §2.3 逐模式映射）
# verify-ca/verify-full 需配 DB_SSL_ROOT_CERT 指向 CA 证书路径
# DB_SSLMODE=prefer
# DB_SSL_ROOT_CERT=

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# ========== 生产环境安全配置（可选）==========
# 默认 DEV=true（开发模式）。生产环境建议按下方"三件套"加固——
# DEV=false + SECRET_KEY + ALLOWED_HOSTS 三者缺一，容器将拒绝启动
# （config.py _validate_security_config 强制校验，防误配）。
#
# 注意：docker-compose 会把本文件的变量透传进 backend 容器
# （environment 段的 ${DEV}/${SECRET_KEY}/${ALLOWED_HOSTS}/${DEBUG}）。
#
# 生产加固三件套示例：
# DEV=false
# SECRET_KEY=请替换为强随机密钥（可用 python -c "import secrets;print(secrets.token_urlsafe(32))"）
# ALLOWED_HOSTS=http://your-domain.com:8080,https://your-domain.com
#
# DEBUG=false（生产默认关闭：避免 500 响应携带完整 traceback）
