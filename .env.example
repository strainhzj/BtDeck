# BtDeck 环境变量配置
# 复制此文件为 .env 并根据需要修改

# 服务端口
BTDECK_PORT=8080

# 时区
TZ=Asia/Shanghai

# 数据库路径（可选，默认 <CONFIG_DIR>/app.db）
# DATABASE_PATH 指定后，应用与 alembic 迁移都操作此库（治理后双源一致）
# DATABASE_PATH=/data/app.db

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# ========== 生产环境安全配置（可选）==========
# 默认 DEV=true（开发模式，迁移失败不终止）。
# 生产环境建议设 DEV=false，启用安全校验（强制要求 SECRET_KEY/ALLOWED_HOSTS）。
# DEV=false

# 生产环境必填（仅当 DEV=false 时强制校验）
# SECRET_KEY=请替换为强随机密钥（可用 python -c "import secrets;print(secrets.token_urlsafe(32))"）
# ALLOWED_HOSTS=http://your-domain.com:8080
