# BtDeck 环境变量配置
# 复制此文件为 .env 并根据需要修改

# 服务端口
BTDECK_PORT=8080

# 时区
TZ=Asia/Shanghai

# 数据库路径（可选，默认 <CONFIG_DIR>/app.db）
# DATABASE_PATH 指定后，应用与 alembic 迁移都操作此库（治理后双源一致）
# DATABASE_PATH=/data/app.db

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# ========== 生产环境安全配置（可选）==========
# 默认 DEV=true（开发模式）。生产环境建议按下方"三件套"加固——
# DEV=false + SECRET_KEY + ALLOWED_HOSTS 三者缺一，容器将拒绝启动
# （config.py _validate_security_config 强制校验，防误配）。
#
# 注意：docker-compose 会把本文件的变量透传进 backend 容器
# （environment 段的 ${DEV}/${SECRET_KEY}/${ALLOWED_HOSTS}/${DEBUG}）。
#
# 生产加固三件套示例：
# DEV=false
# SECRET_KEY=请替换为强随机密钥（可用 python -c "import secrets;print(secrets.token_urlsafe(32))"）
# ALLOWED_HOSTS=http://your-domain.com:8080,https://your-domain.com
#
# DEBUG=false（生产默认关闭：避免 500 响应携带完整 traceback）
