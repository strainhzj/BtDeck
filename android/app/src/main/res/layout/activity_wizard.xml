<?xml version="1.0" encoding="utf-8"?>
<!-- 首启向导：品牌头部（翡翠绿标志圆底 + 标题）+ 两张模式卡片。
     卡片样式对齐前端 element-ui 风格：白底、1px 边框、16dp 圆角、轻阴影、
     翡翠绿图标衬底；id 与旧版一致（wizard_title/wizard_subtitle/card_*）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/btdeck_bg_secondary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_circle_primary_lightest">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_brand_mark"
                app:tint="@color/btdeck_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/wizard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:text="@string/wizard_title"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textColor="@color/btdeck_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wizard_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="@string/wizard_subtitle"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/btdeck_text_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_companion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/btdeck_bg_primary"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:rippleColor="@color/btdeck_primary_lightest"
            app:strokeColor="@color/btdeck_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_primary_lightest"
                    android:contentDescription="@string/wizard_companion_title"
                    android:padding="12dp"
                    android:src="@drawable/ic_mode_companion"
                    app:tint="@color/btdeck_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wizard_companion_title"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textColor="@color/btdeck_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/wizard_companion_desc"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="@color/btdeck_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/btdeck_bg_primary"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:rippleColor="@color/btdeck_primary_lightest"
            app:strokeColor="@color/btdeck_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_primary_lightest"
                    android:contentDescription="@string/wizard_local_title"
                    android:padding="12dp"
                    android:src="@drawable/ic_mode_local"
                    app:tint="@color/btdeck_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wizard_local_title"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textColor="@color/btdeck_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/wizard_local_desc"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="@color/btdeck_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
