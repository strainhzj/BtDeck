<?xml version="1.0" encoding="utf-8"?>
<!-- 服务器 profile 卡片行：健康状态圆点 + 文案同色（代码按状态 tint 语义色）。
     id 与旧版一致（row_name/row_url/row_health/row_meta），Espresso 依赖。
     卡片不置 clickable——点击必须留给 ListView onItemClick（foreground ripple
     由 ListView 按压态驱动）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/btdeck_bg_primary"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/btdeck_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/row_health_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_health_dot" />

            <TextView
                android:id="@+id/row_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textColor="@color/btdeck_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/row_health"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@color/btdeck_text_tertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/btdeck_text_secondary" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/btdeck_text_tertiary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
